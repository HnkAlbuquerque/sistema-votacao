msgstr "GET health (pública)"

msgid "GET list questions"
msgstr "GET listar perguntas"

msgid "GET question"
msgstr "GET pergunta"

msgid "POST vote (body option_id)"
msgstr "POST votar (body option_id)"

msgid "GET results"
msgstr "GET resultados"

msgid "administrator"
msgstr "administrador"

msgid "regular user"
msgstr "usuário comum"

msgid "one-time admin login link"
msgstr "link de login único do administrador"

msgid "questions, options and votes"
msgstr "perguntas, opções e votos"

msgid "check and rebuild counters"
msgstr "verificar e reconstruir os contadores"

msgid "voting log"
msgstr "log da votação"

msgid "run the test suite"
msgstr "executar a suíte de testes"

msgid "Vote page"
msgstr "Página de voto"

msgid "API"
msgstr "API"

msgid "Latest @limit questions. See <a href=\":url\">the full list</a> for the others."
msgstr "Últimas @limit perguntas. Veja <a href=\":url\">a lista completa</a> para as demais."

msgid "Links"
msgstr "Links"

msgid "No questions yet."
msgstr "Ainda não há perguntas."

