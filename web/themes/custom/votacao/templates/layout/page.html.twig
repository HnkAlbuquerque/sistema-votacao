{#
/**
 * @file
 * Theme override to display a single page.
 *
 * Regions: page.header, page.highlighted, page.content, page.footer.
 */
#}
<div class="layout">
  <header class="layout__header site-header" role="banner">
    <div class="container site-header__inner">
      {{ page.header }}
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="{{ 'Switch to dark mode'|t }}" data-label-dark="{{ 'Switch to dark mode'|t }}" data-label-light="{{ 'Switch to light mode'|t }}">
        <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/></svg>
      </button>
    </div>
  </header>

  <main class="layout__main" role="main">
    <a id="main-content" tabindex="-1"></a>
    <div class="container">
      {% if page.highlighted %}
        <div class="layout__highlighted">{{ page.highlighted }}</div>
      {% endif %}
      <div class="layout__content">{{ page.content }}</div>
    </div>
  </main>

  <footer class="layout__footer site-footer" role="contentinfo">
    <div class="container site-footer__inner">
      {{ page.footer }}
      <p class="site-footer__note">{{ 'Simple voting system built with Drupal.'|t }}</p>
    </div>
  </footer>
</div>
