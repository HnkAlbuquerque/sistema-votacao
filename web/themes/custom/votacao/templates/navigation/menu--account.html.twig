{#
/**
 * @file
 * The user account menu, rendered as a compact nav in the header.
 *
 * - account_name: name of the logged-in user, set by votacao_preprocess_menu__account().
 */
#}
{% import _self as menus %}
<div class="account-menu">
  {% if account_name %}
    <span class="account-menu__user">{{ account_name }}</span>
  {% endif %}
  {{ menus.menu_links(items, attributes, 0) }}
</div>

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  {% if items %}
    <ul{{ attributes.addClass('account-menu__list') }}>
      {% for item in items %}
        <li{{ item.attributes.addClass(['account-menu__item', item.in_active_trail ? 'account-menu__item--active']) }}>
          {{ link(item.title, item.url, { 'class': ['account-menu__link'] }) }}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
